digraph UML {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=11, nodesep=0.5, ranksep=0.7, splines=true, bgcolor="white", pad=0.3];
  node  [shape=plaintext, fontname="DejaVu Sans", fontsize=10];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#37474F"];
  "StudentAccountBuilder" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E3F2FD"><FONT POINT-SIZE="9" COLOR="#1A5276">«Builder»</FONT><BR/><B>StudentAccountBuilder</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id, fullName, email : String  {mandatory}<BR ALIGN="LEFT"/>- phone : String = null<BR ALIGN="LEFT"/>- level : String = &quot;L1&quot;<BR ALIGN="LEFT"/>- major : String<BR ALIGN="LEFT"/>- scholarship : boolean = false<BR ALIGN="LEFT"/>- courses : List&lt;String&gt; = []<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ StudentAccountBuilder(id, fullName, email)<BR ALIGN="LEFT"/>+ phone(String) : StudentAccountBuilder<BR ALIGN="LEFT"/>+ level(String) : StudentAccountBuilder<BR ALIGN="LEFT"/>+ major(String) : StudentAccountBuilder<BR ALIGN="LEFT"/>+ scholarship(boolean) : StudentAccountBuilder<BR ALIGN="LEFT"/>+ addCourse(String) : StudentAccountBuilder<BR ALIGN="LEFT"/>+ courses(List&lt;String&gt;) : StudentAccountBuilder<BR ALIGN="LEFT"/>+ build() : StudentAccount<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "StudentAccount" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E3F2FD"><FONT POINT-SIZE="9" COLOR="#1A5276">«Product / ConcretePrototype»</FONT><BR/><B>StudentAccount</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : String<BR ALIGN="LEFT"/>- fullName : String<BR ALIGN="LEFT"/>- email : String<BR ALIGN="LEFT"/>- phone : String<BR ALIGN="LEFT"/>- level : String<BR ALIGN="LEFT"/>- major : String<BR ALIGN="LEFT"/>- scholarship : boolean<BR ALIGN="LEFT"/>- courses : List&lt;String&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">~ StudentAccount(StudentAccountBuilder)<BR ALIGN="LEFT"/>- StudentAccount(StudentAccount)  {deep copy}<BR ALIGN="LEFT"/>+ copy() : StudentAccount<BR ALIGN="LEFT"/>+ copyWithIdentity(id, fullName, email) : StudentAccount<BR ALIGN="LEFT"/>+ addCourse(String) : void<BR ALIGN="LEFT"/>+ getters ...<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "AccountPrototype" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E3F2FD"><FONT POINT-SIZE="9">«interface»</FONT><BR/><FONT POINT-SIZE="9" COLOR="#1A5276">«Prototype»</FONT><BR/><B><I>AccountPrototype</I></B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ copy() : StudentAccount<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "AccountRules" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F5F5F5"><B>AccountRules</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ LEVELS : List&lt;String&gt; = [L1,L2,L3,M1,M2]<BR ALIGN="LEFT"/>+ DEFAULT_LEVEL = &quot;L1&quot;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ checkId(String)<BR ALIGN="LEFT"/>+ checkFullName(String)<BR ALIGN="LEFT"/>+ checkEmail(String)<BR ALIGN="LEFT"/>+ checkLevel(String)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "AccountTemplateRegistry" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E3F2FD"><FONT POINT-SIZE="9" COLOR="#1A5276">«Prototype registry»</FONT><BR/><B>AccountTemplateRegistry</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- templates : Map&lt;String, StudentAccount&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ register(key, StudentAccount)<BR ALIGN="LEFT"/>+ createFrom(key, id, fullName, email) : StudentAccount<BR ALIGN="LEFT"/>+ getTemplate(key) : StudentAccount<BR ALIGN="LEFT"/>+ keys() : List&lt;String&gt;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "AccountRepository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E3F2FD"><FONT POINT-SIZE="9" COLOR="#1A5276">«Singleton»</FONT><BR/><B>AccountRepository</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- accounts : Map&lt;String, StudentAccount&gt;<BR ALIGN="LEFT"/>- AccountRepository()  {private}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getInstance() : AccountRepository  {static}<BR ALIGN="LEFT"/>+ save(StudentAccount)<BR ALIGN="LEFT"/>+ findById(String) : StudentAccount<BR ALIGN="LEFT"/>+ exists(String) : boolean<BR ALIGN="LEFT"/>+ findAll() : List&lt;StudentAccount&gt;<BR ALIGN="LEFT"/>+ count() : int<BR ALIGN="LEFT"/>+ clear()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "AuditLogger" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#E3F2FD"><FONT POINT-SIZE="9" COLOR="#1A5276">«Singleton»</FONT><BR/><B>AuditLogger</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- entries : List&lt;String&gt;<BR ALIGN="LEFT"/>- AuditLogger()  {private}<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getInstance() : AuditLogger  {static}<BR ALIGN="LEFT"/>+ log(action, details)<BR ALIGN="LEFT"/>+ getEntries() : List&lt;String&gt;<BR ALIGN="LEFT"/>+ printAll()<BR ALIGN="LEFT"/>+ clear()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "DuplicateAccountException" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F5F5F5"><B>DuplicateAccountException</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- accountId : String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ getAccountId() : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "Work1Demo" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#F5F5F5"><FONT POINT-SIZE="9" COLOR="#1A5276">«Client»</FONT><BR/><B>Work1Demo</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ main(String[])  {static}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "StudentAccountBuilder" -> "StudentAccount" [arrowhead=vee, style=dashed, label="«creates» build()"];
  "StudentAccount" -> "AccountPrototype" [arrowhead=onormal, style=dashed, label=""];
  "StudentAccountBuilder" -> "AccountRules" [arrowhead=vee, style=dashed, label="validates"];
  "StudentAccount" -> "AccountRules" [arrowhead=vee, style=dashed, label="validates new identity"];
  "AccountTemplateRegistry" -> "StudentAccount" [arrowtail=odiamond, dir=back, label="templates *"];
  "AccountRepository" -> "StudentAccount" [arrowtail=odiamond, dir=back, label="accounts *"];
  "AccountRepository" -> "AuditLogger" [arrowhead=vee, style=dashed, label="log()"];
  "AccountRepository" -> "DuplicateAccountException" [arrowhead=vee, style=dashed, label="throws"];
  "Work1Demo" -> "StudentAccountBuilder" [arrowhead=vee, style=dashed, label="uses"];
  "Work1Demo" -> "AccountRepository" [arrowhead=vee, style=dashed, label="getInstance()"];
  "Work1Demo" -> "AccountTemplateRegistry" [arrowhead=vee, style=dashed, label="uses"];
  {rank=same; "StudentAccountBuilder"; "AccountTemplateRegistry"; "AccountRepository";}
}
